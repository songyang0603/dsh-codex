{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/songyang0603/dsh-codex/conformance/upstream-runtime/oracle-output.schema.json",
  "title": "Pinned Codex runtime-policy oracle output line",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "result"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codexCommit", "coreExecPolicyBlob", "os", "arch"],
      "properties": {
        "codexCommit": { "const": "086396f7f60347b74c82784d5dfaf4fb2d3bda12" },
        "coreExecPolicyBlob": {
          "const": "5de05937533a2653a700b4ec40cda09578761f50"
        },
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement"],
      "properties": {
        "requirement": { "$ref": "#/$defs/requirement" }
      }
    }
  },
  "$defs": {
    "amendment": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requirement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bypassSandbox"],
          "properties": {
            "kind": { "const": "skip" },
            "bypassSandbox": { "type": "boolean" },
            "proposedExecpolicyAmendment": { "$ref": "#/$defs/amendment" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "needs_approval" },
            "reason": { "type": "string" },
            "proposedExecpolicyAmendment": { "$ref": "#/$defs/amendment" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "forbidden" },
            "reason": { "type": "string" }
          }
        }
      ]
    }
  }
}
