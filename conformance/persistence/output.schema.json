{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/songyang0603/dsh-codex/conformance/persistence/output.schema.json",
  "title": "dsh-codex execpolicy persistence differential output record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "corpusSha256", "source", "result"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "corpusSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "codexCommit",
        "configTree",
        "execpolicyTree",
        "coreExecPolicyBlob",
        "coreExecPolicyDirTree",
        "cargoLockBlob",
        "os",
        "arch"
      ],
      "properties": {
        "kind": { "enum": ["upstream_oracle", "sidecar_candidate"] },
        "protocolVersion": { "const": 3 },
        "engineSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "codexCommit": { "const": "086396f7f60347b74c82784d5dfaf4fb2d3bda12" },
        "configTree": { "const": "d3f4925b575b128dd1f0f74a5babcdb1efce0219" },
        "execpolicyTree": {
          "const": "e06e0b4ad718af8a74055a33b1536b25fb9d4a87"
        },
        "coreExecPolicyBlob": {
          "const": "5de05937533a2653a700b4ec40cda09578761f50"
        },
        "coreExecPolicyDirTree": {
          "const": "b313a3ba1b113f08e3c1686272162910dad76540"
        },
        "cargoLockBlob": {
          "const": "a8c2addc02055be48c345b65760a7a1b96cfbf28"
        },
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["skipped"],
          "properties": { "skipped": { "const": "requires_unix" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operations", "finalFilesystem"],
          "properties": {
            "operations": { "type": "array" },
            "finalFilesystem": { "type": "object" }
          }
        }
      ]
    }
  }
}
