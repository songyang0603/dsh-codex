{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/songyang0603/dsh-codex/conformance/approval/adapter-output.schema.json",
  "title": "DSH approval adapter contract output record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "evidence", "result"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "evidence": { "const": "adapter_contract" },
    "result": { "type": "object" }
  }
}
