{
  "name": "@songyang0603/dsh-codex-execpolicy",
  "version": "0.1.0",
  "description": "Pinned Codex execpolicy semantic service for DeepSeek Harness with tracked upstream conformance",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/songyang0603/dsh-codex.git",
    "directory": "packages/execpolicy"
  },
  "homepage": "https://github.com/songyang0603/dsh-codex/tree/main/packages/execpolicy#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "codex",
    "execpolicy",
    "command-policy"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "native/**",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAMS.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "pack:check": "node ../../scripts/verify-package-notices.mjs && publint .",
    "prepack": "node ../../scripts/verify-package-notices.mjs",
    "test": "pnpm run build && vitest run --config vitest.config.ts",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@types/node": "^26.2.0",
    "publint": "^0.3.21",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
